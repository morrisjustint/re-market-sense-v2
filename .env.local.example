NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app URL used in email check-in links (/respond/[token]).
# Example: https://app.remarketsense.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email sending (SendGrid) — required to deliver campaign emails.
# Without these, the app still runs; launches log sends as "skipped".
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=checkins@yourdomain.com
SENDGRID_FROM_NAME=RE Market Sense
